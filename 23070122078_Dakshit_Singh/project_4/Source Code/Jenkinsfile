pipeline {
    agent none

    stages {

        stage('Compile') {
            agent { label 'compile' }

            steps {
                dir('23070122078_Dakshit_Singh/project_4/Source Code') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            agent { label 'test' }

            steps {
                dir('23070122078_Dakshit_Singh/project_4/Source Code') {
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            agent { label 'compile' }

            steps {
                dir('23070122078_Dakshit_Singh/project_4/Source Code') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
    }

    post {
        success {
            echo 'Portfolio pipeline completed successfully!'
        }

        failure {
            echo 'Portfolio pipeline failed.'
        }
    }
}